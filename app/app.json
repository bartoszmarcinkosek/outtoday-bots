{
  "expo": {
    "name": "OutToday",
    "slug": "outtoday",
    "scheme": "outtoday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.outtoday.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OutToday uses your location only to show how far events and places are from you. It is never stored or shared.",
        "NSCalendarsUsageDescription": "OutToday adds events you choose to your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "OutToday adds events you choose to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1B33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ae.outtoday.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0D1B33",
    "owner": "outtoday",
    "extra": {
      "eas": {
        "projectId": "2e98fcaf-cd5d-44dc-bc32-8dd57774691e"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B33"
        }
      ],
      "./plugins/portrait-optional"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2e98fcaf-cd5d-44dc-bc32-8dd57774691e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}